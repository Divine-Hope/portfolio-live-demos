# Copy to .env (git-ignored) and fill in.

# Wikimedia's User-Agent policy asks for a way to reach whoever runs the client:
# an email address or a URL (your repo works). Not needed for `make up-offline`.
INGEST_CONTACT=

# Local-only passwords. ClickHouse is bound to 127.0.0.1, but change them anyway.
CLICKHOUSE_ADMIN_PASSWORD=change-me-admin
CLICKHOUSE_MIGRATOR_PASSWORD=change-me-migrator
CLICKHOUSE_INGEST_PASSWORD=change-me-ingest
CLICKHOUSE_API_PASSWORD=change-me-api
CLICKHOUSE_ARCHIVER_PASSWORD=change-me-archiver
