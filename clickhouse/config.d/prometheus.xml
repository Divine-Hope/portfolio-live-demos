<!--
  Prometheus metrics for Grafana Alloy (deploy/alloy/config.alloy), on the Docker network
  only: no port is published. Alloy keeps a short list of these; see its config.
-->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <errors>false</errors>
    </prometheus>
</clickhouse>
