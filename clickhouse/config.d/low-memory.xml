<!--
  ClickHouse tuned for a 2 GB host (EC2 t4g.small) that also runs ingest, the API and an
  observability agent. Defaults assume a big server; these keep the footprint small and
  predictable. Sized from the retained-volume benchmark (docs/benchmarks.md), under the
  same 1.2 GB container limit.
-->
<clickhouse>
    <!-- Hard ceiling for the whole server, as a share of the container's mem_limit
         (compose.yaml), so it follows a resize. Queries fail before the kernel OOM-kills. -->
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <!-- 26.8 would otherwise keep recomputing that ceiling from the memory left free in the
         container, page cache included, and shrink it as the cache grows: 571 MiB here
         instead of 900. -->
    <memory_worker_dynamic_hard_limit>0</memory_worker_dynamic_hard_limit>

    <!-- Keeps the server's count of its memory in line with the container's real usage
         (docs/postmortems/2026-10-06-clickhouse-memory-drift.md). -->
    <memory_worker_correct_memory_tracker>1</memory_worker_correct_memory_tracker>

    <!-- Caches sized for a dataset of a few GB, not hundreds. -->
    <mark_cache_size>67108864</mark_cache_size> <!-- 64 MiB -->
    <index_mark_cache_size>16777216</index_mark_cache_size> <!-- 16 MiB -->
    <max_concurrent_queries>32</max_concurrent_queries>

    <!-- Fewer background threads: one writer, small parts, little to merge. -->
    <background_pool_size>4</background_pool_size>
    <!-- Queue slots, not threads: 4 x 7 = 28, above the 25 that ADD PROJECTION checks. -->
    <background_merges_mutations_concurrency_ratio>7</background_merges_mutations_concurrency_ratio>
    <background_common_pool_size>2</background_common_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>

    <merge_tree>
        <merge_max_block_size>1024</merge_max_block_size>
        <max_bytes_to_merge_at_max_space_in_pool>1073741824</max_bytes_to_merge_at_max_space_in_pool>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>0</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <!-- System log tables cost memory and disk. Keep the two that diagnose a slow query or
         a merge backlog, for three days; the application users log only slow queries
         (see users.d). Drop the rest; our own metrics cover them. -->
    <!-- Merged into the server's default definitions: only the retention is ours. -->
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </part_log>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <error_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <aggregated_zookeeper_log remove="1"/>
    <zookeeper_connection_log remove="1"/>
    <delta_lake_metadata_log remove="1"/>
    <s3queue_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <iceberg_metadata_log remove="1"/>
    <blob_storage_log remove="1"/>
    <backup_log remove="1"/>

    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
