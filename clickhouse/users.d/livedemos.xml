<!--
  Four application users, least privilege:
    migrator  changes the schema; only the one-shot `migrate` job runs as it. Also
              rewrites the rollup (reconcile repairs, rebuilds from the archive)
    ingest    reads and inserts rows; can't change the schema
    api       read-only, with tight per-query limits (it faces the public internet)
    archiver  reads raw rows and writes them to S3 as Parquet; nothing else
  Passwords come from environment variables, never from this file.
-->
<clickhouse>
    <profiles>
        <writer>
            <max_threads>2</max_threads>
            <max_insert_threads>1</max_insert_threads>
            <max_memory_usage>300000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
            <!-- A retried, deduplicated insert must not double-count in the rollup either. -->
            <deduplicate_blocks_in_dependent_materialized_views>1</deduplicate_blocks_in_dependent_materialized_views>
            <!-- On by default since 26.3. Ingest already batches, and exactly-once relies on
                 a synchronous insert committing under its dedup token (ADR 0006). -->
            <async_insert>0</async_insert>
            <!-- An insert a second: log only the slow ones (system.query_log, kept 3 days). -->
            <log_queries>1</log_queries>
            <log_queries_min_query_duration_ms>500</log_queries_min_query_duration_ms>
        </writer>
        <!-- The writer's limits, plus permission to sign s3() with the server's own
             credentials (the instance role), which 26.8 refuses to user queries by default.
             Only archiver and migrator get it, and their S3 grants reach only the archive. -->
        <archive>
            <profile>writer</profile>
            <s3_allow_server_credentials_in_user_queries>1</s3_allow_server_credentials_in_user_queries>
        </archive>
        <reader>
            <!-- readonly=2: no writes; the client may change settings, but only within
                 the constraints below, so it can tighten limits and never raise them. -->
            <readonly>2</readonly>
            <max_threads>2</max_threads>
            <max_memory_usage>200000000</max_memory_usage>
            <max_execution_time>3</max_execution_time>
            <max_result_rows>10000</max_result_rows>
            <queue_max_wait_ms>1000</queue_max_wait_ms>
            <log_queries>1</log_queries>
            <log_queries_min_query_duration_ms>100</log_queries_min_query_duration_ms>
            <constraints>
                <readonly><const/></readonly>
                <max_threads><max>2</max></max_threads>
                <max_memory_usage><max>200000000</max></max_memory_usage>
                <max_execution_time><max>3</max></max_execution_time>
                <max_result_rows><max>10000</max></max_result_rows>
            </constraints>
        </reader>
    </profiles>

    <users>
        <migrator>
            <password from_env="CLICKHOUSE_MIGRATOR_PASSWORD"/>
            <profile>archive</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT CREATE DATABASE ON demos.*</query>
                <query>GRANT CREATE TABLE, CREATE VIEW, ALTER, SELECT, INSERT ON demos.*</query>
                <!-- Its run lock (migrate.py), and nothing else it may drop. -->
                <query>GRANT DROP TABLE ON demos.schema_migrations_lock</query>
                <!-- Reconcile repairs only while no ingest insert runs: it must see them. -->
                <query>GRANT SELECT(query_id, current_database, user) ON system.processes</query>
                <!-- Rebuilding the rollup: read the archive (only), stage, then replace. -->
                <query>GRANT READ ON S3('https?://(livedemos-archive-[a-z0-9-]+\\.s3\\.[a-z0-9-]+\\.amazonaws\\.com|s3:8333/archive)/.*')</query>
                <query>GRANT CREATE TEMPORARY TABLE ON *.*</query>
                <query>GRANT TRUNCATE ON demos.wiki_edits_per_minute_staging</query>
            </grants>
        </migrator>
        <ingest>
            <password from_env="CLICKHOUSE_INGEST_PASSWORD"/>
            <profile>writer</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT, INSERT ON demos.*</query>
                <!-- On start, ingest waits for its database's inserts still running
                     (see resume.py). Two columns, nothing else in the process list. -->
                <query>GRANT SELECT(query_id, current_database) ON system.processes</query>
            </grants>
        </ingest>
        <api>
            <password from_env="CLICKHOUSE_API_PASSWORD"/>
            <profile>reader</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON demos.*</query>
            </grants>
        </api>
        <archiver>
            <password from_env="CLICKHOUSE_ARCHIVER_PASSWORD"/>
            <profile>archive</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON demos.wiki_edits</query>
                <query>GRANT SELECT, INSERT ON demos.archive_hours</query>
                <!-- s3() reaches only the archive bucket (production) or the local stand-in;
                     any other URL is refused. A table function needs a temporary table. -->
                <query>GRANT READ, WRITE ON S3('https?://(livedemos-archive-[a-z0-9-]+\\.s3\\.[a-z0-9-]+\\.amazonaws\\.com|s3:8333/archive)/.*')</query>
                <query>GRANT CREATE TEMPORARY TABLE ON *.*</query>
            </grants>
        </archiver>
    </users>
</clickhouse>
