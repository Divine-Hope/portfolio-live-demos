[Unit]
Description=Live demos stack (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/livedemos
ExecStart=/opt/livedemos/deploy/host/start.sh
# A rebuilt host restores from the archive before the stack starts (archive/restore.py).
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
